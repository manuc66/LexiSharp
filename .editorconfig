# EditorConfig root: do not inherit settings from any parent file.
root = true

# Cosmetic style rules from the .NET SDK analyzers and xunit.analyzers that
# SonarCloud treats as unactionable noise in test code. They are silenced at
# the Roslyn level (the only lever the C#/Sonar scanner honors for external
# analyzer diagnostics) and scoped to tests only: source analysis is unchanged.
# Real defects in tests (S2xxx, CA2200, xUnit1013, ...) are still reported.
[**/*Tests*/**/*.cs]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1865.severity = none
dotnet_diagnostic.xUnit1042.severity = none
dotnet_diagnostic.xUnit1044.severity = none