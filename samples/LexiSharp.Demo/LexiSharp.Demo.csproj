<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LexiSharp.Demo</RootNamespace>
    <AssemblyName>LexiSharp.Demo</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LexiSharp/LexiSharp.csproj" />
  </ItemGroup>

  <!-- The corpus is a file, not C#: the browser demo serves the same one, and a single copy is
       what stops the two hosts from indexing different documents. -->
  <ItemGroup>
    <EmbeddedResource Include="corpus.json" LogicalName="LexiSharp.Demo.corpus.json" />
  </ItemGroup>

</Project>
