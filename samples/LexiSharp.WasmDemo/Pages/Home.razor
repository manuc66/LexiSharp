@page "/"
@using System.Diagnostics
@using System.Globalization
@using System.Text.Json
@using LexiSharp.Core
@using LexiSharp.Indexing
@using LexiSharp.Ranking
@inject HttpClient Http

<PageTitle>LexiSharp · in-browser search</PageTitle>

<style>
    .wasm-hero { padding: 28px 0 18px; border-bottom: 1px solid #e5e7eb; }
    .wasm-hero h1 { margin: 0 0 6px; font-size: 30px; letter-spacing: -0.02em; }
    .wasm-hero p { margin: 0; color: #5b6472; max-width: 640px; }
    .wasm-search { display: flex; gap: 8px; margin: 22px 0 10px; }
    .wasm-search input { flex: 1; padding: 12px 14px; border: 1px solid #d6dbe3; border-radius: 10px; font-size: 15px; }
    .wasm-search button { padding: 12px 18px; border: 0; border-radius: 10px; background: #2563eb; color: white; font-weight: 600; cursor: pointer; }
    .wasm-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .wasm-chip { padding: 6px 12px; border: 1px solid #d6dbe3; border-radius: 999px; background: white; color: #475569; cursor: pointer; font-size: 13px; }
    .wasm-chip:hover { border-color: #2563eb; color: #1d4ed8; }
    .wasm-stats { color: #64748b; font-size: 13px; margin: 0 0 18px; }
    .wasm-card { border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; background: white; }
    .wasm-head { display: flex; align-items: center; gap: 8px; }
    .wasm-id { font-weight: 600; }
    .wasm-cat { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #64748b; border: 1px solid #e5e7eb; border-radius: 999px; padding: 1px 7px; }
    .wasm-score { margin-left: auto; color: #2563eb; font-variant-numeric: tabular-nums; font-size: 13px; }
    .wasm-text { color: #475569; margin-top: 6px; font-size: 14px; }
    .wasm-empty { color: #64748b; padding: 18px 0; }
    .wasm-note { color: #64748b; font-size: 12px; margin-top: 22px; }
</style>

<div class="wasm-hero">
    <h1>LexiSharp in the browser</h1>
    <p>BM25 and an inverted index run entirely in WebAssembly. No server and no search API: the corpus is a static file, and the index never leaves the tab.</p>
</div>

<div class="wasm-search">
    <input @bind="Query" @bind:event="oninput" @onkeydown="OnKeyDown" placeholder="Search @_documentCount documents…" />
    <button @onclick="Search">Search</button>
</div>

<div class="wasm-chips">
    @foreach (var pick in Picks)
    {
        <button class="wasm-chip" @onclick="() => Pick(pick)">@pick</button>
    }
</div>

<p class="wasm-stats">
    @_documentCount documents · indexed in @_indexMs.ToString("0.###", CultureInfo.InvariantCulture) ms
    @if (_usedFallback)
    {
        <text>· built-in fallback (corpus.json unavailable)</text>
    }
</p>

@if (Results.Count > 0)
{
    @foreach (var hit in Results)
    {
        <div class="wasm-card">
            <div class="wasm-head">
                <span class="wasm-id">@TitleOf(hit.Document)</span>
                @if (!string.IsNullOrEmpty(hit.Document.Category))
                {
                    <span class="wasm-cat">@hit.Document.Category</span>
                }
                <span class="wasm-score">score @hit.Score.ToString("0.###", CultureInfo.InvariantCulture)</span>
            </div>
            <div class="wasm-text">@hit.Document.Text</div>
        </div>
    }
}
else if (!string.IsNullOrWhiteSpace(Query))
{
    <div class="wasm-empty">No match in this corpus.</div>
}

<p class="wasm-note">
    The corpus is fetched once from a static file; the search itself never leaves the tab. The
    server demo also exercises classification, segment storage, persistence and the optional packages.
</p>

@code {
    private static readonly string[] Picks =
    {
        "refresh token",
        "short lived credential",
        "ranking quality",
        "session expiry",
        "embeddings",
        "inverted index",
    };

    /// <summary>
    /// The three documents of the README quick start. They are the fallback, not the demo: if
    /// <c>corpus.json</c> cannot be read (offline, a host that did not publish it) the page still
    /// proves the search path rather than showing an empty screen.
    /// </summary>
    private static readonly SearchDocument[] FallbackCorpus =
    {
        new("1", "The search engine uses BM25 to rank documents"),
        new("2", "TF-IDF is a classic method of textual search"),
        new("3", "Italian cuisine is renowned in Rome"),
    };

    private string Query { get; set; } = "refresh token";
    private ITextSearchEngine? _engine;
    private IReadOnlyList<SearchResult> Results { get; set; } = Array.Empty<SearchResult>();
    private int _documentCount;
    private double _indexMs;
    private bool _usedFallback;

    protected override async Task OnInitializedAsync()
    {
        (List<SearchDocument> documents, bool fromFile) = await LoadCorpusAsync();
        _usedFallback = !fromFile;

        _engine = new RankedTextSearchEngine(new InMemoryTextIndex(), new Bm25Scorer());

        Stopwatch stopwatch = Stopwatch.StartNew();
        _engine.Index(documents);
        stopwatch.Stop();

        _documentCount = documents.Count;
        _indexMs = stopwatch.Elapsed.TotalMilliseconds;

        Search();
    }

    private async Task<(List<SearchDocument> Documents, bool FromFile)> LoadCorpusAsync()
    {
        try
        {
            List<CorpusDocument>? corpus = await Http.GetFromJsonAsync(
                "corpus.json", CorpusJsonContext.Default.ListCorpusDocument);

            if (corpus is { Count: > 0 })
                return (corpus.Select(ToSearchDocument).ToList(), true);
        }
        catch (HttpRequestException)
        {
            // The file is missing or the browser is offline; the fallback below is the point.
        }
        catch (JsonException)
        {
            // A corpus that does not parse is the same as no corpus for this page.
        }

        return (FallbackCorpus.ToList(), false);
    }

    private static SearchDocument ToSearchDocument(CorpusDocument document) =>
        new(document.Id, document.Text,
            new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["title"] = document.Title,
                ["category"] = document.Category,
            },
            document.Category);

    private static string TitleOf(SearchDocument document) =>
        document.Fields is not null && document.Fields.TryGetValue("title", out string? title)
            ? title
            : document.Id;

    private void Pick(string pick)
    {
        Query = pick;
        Search();
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            Search();
    }

    private void Search()
    {
        if (_engine is null || string.IsNullOrWhiteSpace(Query))
        {
            Results = Array.Empty<SearchResult>();
            return;
        }

        Results = _engine.Search(Query, new SearchOptions(Limit: 10));
    }
}
