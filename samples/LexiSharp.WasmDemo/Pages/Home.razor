@page "/"
@using System.Diagnostics
@using System.Globalization
@using System.Text.Json
@using LexiSharp.Core
@using LexiSharp.Hybrid
@using LexiSharp.Indexing
@using LexiSharp.Ranking
@inject HttpClient Http

<PageTitle>LexiSharp · in-browser search</PageTitle>

<style>
    .wasm-hero { padding: 28px 0 18px; border-bottom: 1px solid #e5e7eb; }
    .wasm-hero h1 { margin: 0 0 6px; font-size: 30px; letter-spacing: -0.02em; }
    .wasm-hero p { margin: 0; color: #5b6472; max-width: 640px; }
    .wasm-search { display: flex; gap: 8px; margin: 22px 0 10px; }
    .wasm-search input { flex: 1; padding: 12px 14px; border: 1px solid #d6dbe3; border-radius: 10px; font-size: 15px; }
    .wasm-search button { padding: 12px 18px; border: 0; border-radius: 10px; background: #2563eb; color: white; font-weight: 600; cursor: pointer; }
    .wasm-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .wasm-chip { padding: 6px 12px; border: 1px solid #d6dbe3; border-radius: 999px; background: white; color: #475569; cursor: pointer; font-size: 13px; }
    .wasm-chip:hover { border-color: #2563eb; color: #1d4ed8; }
    .wasm-stats { color: #64748b; font-size: 13px; margin: 0 0 18px; }
    .wasm-card { border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; background: white; }
    .wasm-head { display: flex; align-items: center; gap: 8px; }
    .wasm-id { font-weight: 600; }
    .wasm-cat { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #64748b; border: 1px solid #e5e7eb; border-radius: 999px; padding: 1px 7px; }
    .wasm-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .wasm-score { color: #2563eb; font-variant-numeric: tabular-nums; font-size: 13px; }
    .wasm-similar { border: 1px solid #d6dbe3; background: white; color: #1d4ed8; border-radius: 999px; padding: 2px 10px; font-size: 11.5px; cursor: pointer; }
    .wasm-similar:hover { border-color: #2563eb; background: #eff6ff; }
    .wasm-text { color: #475569; margin-top: 6px; font-size: 14px; }
    .wasm-empty { color: #64748b; padding: 18px 0; }
    .wasm-similar-panel { border: 1px solid #dbe4f0; background: #f8fafc; border-radius: 12px; padding: 14px 16px; margin: 0 0 18px; }
    .wasm-similar-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .wasm-similar-head h2 { margin: 0; font-size: 15px; letter-spacing: -0.01em; }
    .wasm-similar-head button { margin-left: auto; }
    .wasm-card-similar .wasm-score { margin-left: auto; }
    .wasm-explain-meta { color: #475569; font-size: 12.5px; margin: 0 0 12px; }
    .wasm-terms-wrap { overflow-x: auto; }
    .wasm-terms { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .wasm-terms th { text-align: left; color: #64748b; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; border-bottom: 1px solid #e2e8f0; padding: 0 12px 6px 0; white-space: nowrap; }
    .wasm-terms td { padding: 6px 12px 6px 0; border-bottom: 1px solid #eef2f7; font-variant-numeric: tabular-nums; }
    .wasm-terms tr:last-child td { border-bottom: 0; }
    .wasm-terms td:first-child { font-family: SFMono-Regular, Menlo, Consolas, monospace; }
    .wasm-term-score { text-align: right; color: #2563eb; }
    .wasm-disclosure { color: #64748b; font-size: 11.5px; line-height: 1.5; margin: 10px 0 0; }
    .wasm-note { color: #64748b; font-size: 12px; margin-top: 22px; }
</style>

<div class="wasm-hero">
    <h1>LexiSharp in the browser</h1>
    <p>BM25 and an inverted index run entirely in WebAssembly. No server and no search API: the corpus is a static file, and the index never leaves the tab.</p>
</div>

<div class="wasm-search">
    <input @bind="Query" @bind:event="oninput" @onkeydown="OnKeyDown" placeholder="Search @_documentCount documents…" />
    <button @onclick="Search">Search</button>
</div>

<div class="wasm-chips">
    @foreach (var pick in Picks)
    {
        <button class="wasm-chip" @onclick="() => Pick(pick)">@pick</button>
    }
</div>

<p class="wasm-stats">
    @_documentCount documents · indexed in @_indexMs.ToString("0.###", CultureInfo.InvariantCulture) ms
    @if (_usedFallback)
    {
        <text>· built-in fallback (corpus.json unavailable)</text>
    }
</p>

@if (_explained is not null)
{
    <section class="wasm-similar-panel">
        <div class="wasm-similar-head">
            <h2>Why “@TitleOf(_explained.Document)” scored @N(_explained.Explanation.TotalScore)</h2>
            <button class="wasm-chip" @onclick="CloseExplain">Close</button>
        </div>

        <p class="wasm-explain-meta">
            @_explained.Explanation.Algorithm ·
            document @_explained.Explanation.DocumentLength tokens,
            corpus average @N(_explained.Explanation.AverageDocumentLength),
            ratio @N(_explained.Explanation.LengthRatio) ·
            length normalization @N(_explained.Explanation.LengthNormalization)
            @foreach (var parameter in _explained.Explanation.Parameters)
            {
                <text> · @parameter.Key = @N(parameter.Value)</text>
            }
        </p>

        <div class="wasm-terms-wrap">
            <table class="wasm-terms">
                <thead>
                    <tr>
                        <th>Term</th>
                        <th>tf</th>
                        <th>df</th>
                        <th>idf</th>
                        <th class="wasm-term-score">contribution</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var term in _explained.Explanation.Terms)
                    {
                        <tr>
                            <td>@term.Term</td>
                            <td>@N(term.TermFrequency)</td>
                            <td>@N(term.DocumentFrequency)</td>
                            <td>@N(term.InverseDocumentFrequency)</td>
                            <td class="wasm-term-score">@N(term.Score)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="wasm-disclosure">
            BM25 scored the document in this tab; this breakdown is the engine's own explanation,
            not a re-derivation. Terms absent from the document are omitted, so the contributions
            shown are exactly the ones that added up to the score.
        </p>
    </section>
}

@if (_similarTo is not null && _similarResults.Count > 0)
{
    <section class="wasm-similar-panel">
        <div class="wasm-similar-head">
            <h2>Similar to “@TitleOf(_similarTo)”</h2>
            <button class="wasm-chip" @onclick="CloseSimilar">Close</button>
        </div>

        @foreach (var hit in _similarResults)
        {
            <div class="wasm-card wasm-card-similar">
                <div class="wasm-head">
                    <span class="wasm-id">@TitleOf(hit.Document)</span>
                    @if (!string.IsNullOrEmpty(hit.Document.Category))
                    {
                        <span class="wasm-cat">@hit.Document.Category</span>
                    }
                    <span class="wasm-score">cosine @hit.Score.ToString("0.000", CultureInfo.InvariantCulture)</span>
                </div>
                <div class="wasm-text">@hit.Document.Text</div>
            </div>
        }

        <p class="wasm-disclosure">
            Document vectors were precomputed offline with <b>@_embeddingModel</b>
            (@_embeddingDimension dimensions); the tab only loads them and compares them. No model is
            downloaded, loaded or executed here.
        </p>
    </section>
}

@if (Results.Count > 0)
{
    @foreach (var hit in Results)
    {
        <div class="wasm-card">
            <div class="wasm-head">
                <span class="wasm-id">@TitleOf(hit.Document)</span>
                @if (!string.IsNullOrEmpty(hit.Document.Category))
                {
                    <span class="wasm-cat">@hit.Document.Category</span>
                }
                <span class="wasm-actions">
                    <button class="wasm-similar" @onclick="() => Explain(hit.Document)">why</button>
                    @if (HasSimilar)
                    {
                        <button class="wasm-similar" @onclick="() => ShowSimilar(hit.Document)">similar</button>
                    }
                    <span class="wasm-score">score @hit.Score.ToString("0.###", CultureInfo.InvariantCulture)</span>
                </span>
            </div>
            <div class="wasm-text">@hit.Document.Text</div>
        </div>
    }
}
else if (!string.IsNullOrWhiteSpace(Query))
{
    <div class="wasm-empty">No match in this corpus.</div>
}

<p class="wasm-note">
    The corpus and the similar-documents vectors are static files; the index and every comparison
    run in the tab. The server demo also exercises classification, segment storage, persistence and
    the optional packages.
</p>

@code {
    private static readonly string[] Picks =
    {
        "refresh token",
        "short lived credential",
        "ranking quality",
        "session expiry",
        "embeddings",
        "inverted index",
    };

    /// <summary>
    /// The three documents of the README quick start. They are the fallback, not the demo: if
    /// <c>corpus.json</c> cannot be read (offline, a host that did not publish it) the page still
    /// proves the search path rather than showing an empty screen.
    /// </summary>
    private static readonly SearchDocument[] FallbackCorpus =
    {
        new("1", "The search engine uses BM25 to rank documents"),
        new("2", "TF-IDF is a classic method of textual search"),
        new("3", "Italian cuisine is renowned in Rome"),
    };

    private readonly Dictionary<string, SearchDocument> _documentsById = new(StringComparer.Ordinal);
    private readonly Dictionary<string, float[]> _vectorsById = new(StringComparer.Ordinal);

    private string Query { get; set; } = "refresh token";
    private ITextSearchEngine? _engine;
    private IReadOnlyList<SearchResult> Results { get; set; } = Array.Empty<SearchResult>();
    private SearchDocument? _similarTo;
    private IReadOnlyList<SimilarHit> _similarResults = Array.Empty<SimilarHit>();
    private ExplainedHit? _explained;
    private string _appliedQuery = string.Empty;
    private string? _embeddingModel;
    private int _embeddingDimension;
    private int _documentCount;
    private double _indexMs;
    private bool _usedFallback;

    private bool HasSimilar => _vectorsById.Count > 1;

    protected override async Task OnInitializedAsync()
    {
        (List<SearchDocument> documents, bool fromFile) = await LoadCorpusAsync();
        _usedFallback = !fromFile;

        foreach (SearchDocument document in documents)
            _documentsById[document.Id] = document;

        _engine = new RankedTextSearchEngine(new InMemoryTextIndex(), new Bm25Scorer());

        Stopwatch stopwatch = Stopwatch.StartNew();
        _engine.Index(documents);
        stopwatch.Stop();

        _documentCount = documents.Count;
        _indexMs = stopwatch.Elapsed.TotalMilliseconds;

        await LoadEmbeddingsAsync();

        Search();
    }

    private async Task<(List<SearchDocument> Documents, bool FromFile)> LoadCorpusAsync()
    {
        try
        {
            List<CorpusDocument>? corpus = await Http.GetFromJsonAsync(
                "corpus.json", CorpusJsonContext.Default.ListCorpusDocument);

            if (corpus is { Count: > 0 })
                return (corpus.Select(ToSearchDocument).ToList(), true);
        }
        catch (HttpRequestException)
        {
            // The file is missing or the browser is offline; the fallback below is the point.
        }
        catch (JsonException)
        {
            // A corpus that does not parse is the same as no corpus for this page.
        }

        return (FallbackCorpus.ToList(), false);
    }

    /// <summary>
    /// Loads the precomputed vectors. They are an optional feature, not a requirement: if the file
    /// is absent or malformed the page keeps its BM25 search and simply does not offer "similar".
    /// </summary>
    private async Task LoadEmbeddingsAsync()
    {
        try
        {
            EmbeddingFile? file = await Http.GetFromJsonAsync(
                "embeddings.json", CorpusJsonContext.Default.EmbeddingFile);

            if (file is null)
                return;

            foreach ((string id, float[] vector) in file.Documents)
            {
                if (vector.Length == file.Dimension && _documentsById.ContainsKey(id))
                    _vectorsById[id] = vector;
            }

            if (HasSimilar)
            {
                _embeddingModel = file.Model;
                _embeddingDimension = file.Dimension;
            }
        }
        catch (HttpRequestException)
        {
            // No vectors published: the demo stays BM25-only.
        }
        catch (JsonException)
        {
            // Vectors that do not parse are the same as no vectors.
        }
    }

    private static SearchDocument ToSearchDocument(CorpusDocument document) =>
        new(document.Id, document.Text,
            new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["title"] = document.Title,
                ["category"] = document.Category,
            },
            document.Category);

    private static string TitleOf(SearchDocument document) =>
        document.Fields is not null && document.Fields.TryGetValue("title", out string? title)
            ? title
            : document.Id;

    private void Pick(string pick)
    {
        Query = pick;
        Search();
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            Search();
    }

    private void Search()
    {
        CloseSimilar();
        CloseExplain();

        if (_engine is null || string.IsNullOrWhiteSpace(Query))
        {
            _appliedQuery = string.Empty;
            Results = Array.Empty<SearchResult>();
            return;
        }

        _appliedQuery = Query.Trim();
        Results = _engine.Search(_appliedQuery, new SearchOptions(Limit: 10));
    }

    /// <summary>
    /// Ranks the other documents against this one. The source vector is already in
    /// <see cref="_vectorsById"/>, so no text is embedded: this is a cosine scan, which is exactly
    /// the claim the panel makes.
    /// </summary>
    private void ShowSimilar(SearchDocument source)
    {
        CloseExplain();

        if (!_vectorsById.TryGetValue(source.Id, out float[]? sourceVector))
            return;

        var hits = new List<SimilarHit>(_vectorsById.Count);

        foreach ((string id, float[] vector) in _vectorsById)
        {
            if (id == source.Id || !_documentsById.TryGetValue(id, out SearchDocument? document))
                continue;

            hits.Add(new SimilarHit(document, VectorSimilarity.CosineSimilarity(sourceVector, vector)));
        }

        _similarTo = source;
        _similarResults = hits
            .OrderByDescending(hit => hit.Score)
            .ThenBy(hit => hit.Document.Id, StringComparer.Ordinal)
            .Take(5)
            .ToList();
    }

    private void CloseSimilar()
    {
        _similarTo = null;
        _similarResults = Array.Empty<SimilarHit>();
    }

    /// <summary>
    /// Asks the engine for its own breakdown of this document's score under the query that
    /// produced the visible results. The query is the applied one, not the text box: typing a new
    /// query without pressing Search must not explain an old result against new text.
    /// </summary>
    private void Explain(SearchDocument document)
    {
        if (_engine is not IExplainableSearchEngine explainer || _appliedQuery.Length == 0)
            return;

        ScoreExplanation? explanation = explainer.Explain(document.Id, _appliedQuery);
        if (explanation is null)
            return;

        CloseSimilar();
        _explained = new ExplainedHit(document, explanation);
    }

    private void CloseExplain() => _explained = null;

    private static string N(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private sealed record SimilarHit(SearchDocument Document, float Score);

    private sealed record ExplainedHit(SearchDocument Document, ScoreExplanation Explanation);
}
