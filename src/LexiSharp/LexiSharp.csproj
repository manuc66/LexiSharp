<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>LexiSharp</RootNamespace>
    <PackageId>LexiSharp</PackageId>
    <Title>LexiSharp</Title>
    <Description>A composable information retrieval toolkit for .NET: in-memory inverted index, BM25/TF-IDF/query-likelihood/boolean scorers, rank fusion (RRF, cascade, MMR, MaxSim, cross-encoder) and model-agnostic dense/learned-sparse seams, plus IR metrics, BM25 tuning and end-to-end search traces. The core package has no runtime dependency.</Description>
    <Authors>manu</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageTags>search;text;lexical;tf-idf;bm25;classification;naive-bayes;incremental-learning;feedback;hybrid;federation;rrf;reranking</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Two friends, and only two. Both drive the golden master — the repository's own ranking
    regression net — which is internal on purpose: a consumer who installs this package was
    given a second way to compare rankings, duplicating what the public benchmarking API
    already does, and nobody outside this repository reads one.

    bench/LexiSharp.Cli is the `baseline` and `verify` commands, the only things that write
    and read a baseline file. tests/LexiSharp.Tests is the suite that pins the format and the
    comparison rules, and a test that cannot see the type it is testing is a test that has to
    go through the CLI to do it.

    Both live under bench/ and tests/, so neither ships. This assembly is not strong-named, so the
    friend list is a name check and nothing more — any assembly calling itself LexiSharp.Tests
    would pass it. That is the ordinary trade for keeping build tooling out of a shipped package,
    and it bounds the exposure to internals a consumer would have to deliberately claim the name
    to reach.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="LexiSharp.Cli" />
    <InternalsVisibleTo Include="LexiSharp.Tests" />
  </ItemGroup>

</Project>