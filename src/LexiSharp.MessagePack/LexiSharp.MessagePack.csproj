<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>LexiSharp.MessagePack</RootNamespace>
    <PackageId>LexiSharp.MessagePack</PackageId>
    <Title>LexiSharp.MessagePack</Title>
    <Description>MessagePack persistence for the LexiSharp in-memory text index: save and reload a full corpus as compact binary.</Description>
    <Authors>manu</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageTags>search;text;index;persistence;messagepack;binary;serialization</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LexiSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LexiSharp/LexiSharp.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.10" />
  </ItemGroup>

</Project>
