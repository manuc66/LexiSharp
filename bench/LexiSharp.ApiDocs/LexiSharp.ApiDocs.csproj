<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>LexiSharp.ApiDocs</RootNamespace>
    <Description>
      Internal build tooling. Generates the API reference page from the compiled assemblies and
      the XML documentation they ship, so the page cannot drift from the public surface. Not part
      of the shipped library.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LexiSharp.Tests" />
  </ItemGroup>

</Project>
