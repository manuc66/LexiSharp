<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>LexiSharp.Eval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LexiSharp/LexiSharp.csproj" />
    <ProjectReference Include="../../src/LexiSharp.MessagePack/LexiSharp.MessagePack.csproj" />
    <!-- The pgvector lane. Referenced so the ANN curve can be a command against a real server
         rather than a script that has to be retyped; a default run still never touches Postgres,
         and the tests auto-skip without POSTGRES_TEST_CONNECTION. -->
    <ProjectReference Include="../../src/LexiSharp.Postgres/LexiSharp.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The per-query analysis is internal to this harness and the test project is the only caller
         that should see it. Widening it to public would make it API this repository then has to keep. -->
    <InternalsVisibleTo Include="LexiSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The per-query analysis is internal, and the test project is the only caller that should see
         it. Internals are not widened to make a type public: nothing in this harness is API. -->
    <InternalsVisibleTo Include="LexiSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

</Project>