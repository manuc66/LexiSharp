<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LexiSharp/LexiSharp.csproj" />
    <!-- The BEIR corpora are the only real documents this repository has to hand, and the harness
         already loads them (download, checksum, jsonl, qrels). A second jsonl reader here would be
         a copy free to drift from the one the measured-quality numbers come from, so the cursor
         lane borrows the loader instead of writing its own. -->
    <ProjectReference Include="../LexiSharp.Eval/LexiSharp.Eval.csproj" />
  </ItemGroup>

</Project>