<Project>

  <!--
    CS1591 (missing XML comment on a public member) is NOT suppressed. It used to be, set
    per project, and the suppression is gone: every package sets GenerateDocumentationFile,
    the SDK packs the resulting LexiSharp.xml into the nupkg, and that file is what a
    consumer's IntelliSense reads. A public member with no `<summary>` is therefore a hole in
    a shipped artifact rather than a style preference, and the warning is the cheapest way to
    keep it closed. The five the warning found when it was enabled are documented now, and
    the generated API reference (bench/LexiSharp.ApiDocs) reads that same XML, so a hole
    shows up there as an empty "What it is" cell.
  -->

  <!--
    Symbol packages. Portable PDBs are produced by default in Release, but they are
    discarded by the pack: setting IncludeSymbols puts each assembly's PDB in a .snupkg
    alongside the .nupkg, which is what nuget.org's symbol server expects. Applied to every
    project here (not just the packable ones) because this file is imported before each
    project body, so IsPackable is not yet defined at evaluation time; non-packable projects
    never produce a package and are unaffected.

    SourceLink is not referenced explicitly: the .NET SDK imports Microsoft.SourceLink.GitHub
    in-box, so the PDBs already carry a mapping to the repository. Verified by inspecting a
    produced .snupkg (see .github/workflows/ci.yml, "Symbol packages").
  -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Deterministic source paths. Normalizing them turns the agent's checkout directory
    into a repository-relative path inside the PDB, so a debugger that reads a published
    PDB does not resolve sources under /home/runner/work. Only in CI: it changes the path
    mapping recorded in the PDB, so applying it locally too would make local PDBs differ
    from the published ones. GitHub Actions sets CI=true.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    The package version, declared once for every project. It used to be a <Version> in each
    of the four packable csproj files, and a documentation page carried the same number in
    prose, so a release meant editing five places and forgetting one: `5248329` is a commit
    whose whole content is the version being three pages stale after a release.

    Here rather than in a shared .props of its own, because this file is imported before
    every project body, so the property is set before anything can override it. That is the
    whole reason it lives here and not in a Directory.Packages.props-style import: an
    explicit <Version> in a csproj still wins, silently, and a version that only *looks*
    centralized is worse than one that was duplicated visibly. VersionTests.cs reads the four
    csproj files to keep the duplication from coming back.
  -->
  <PropertyGroup>
    <Version>0.7.0</Version>
  </PropertyGroup>

</Project>
