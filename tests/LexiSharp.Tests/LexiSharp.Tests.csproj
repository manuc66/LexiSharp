<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FsCheck" Version="3.4.0" />
    <PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LexiSharp/LexiSharp.csproj" />
    <ProjectReference Include="../../src/LexiSharp.AspNetCore/LexiSharp.AspNetCore.csproj" />
    <ProjectReference Include="../../src/LexiSharp.MessagePack/LexiSharp.MessagePack.csproj" />
    <ProjectReference Include="../../src/LexiSharp.Postgres/LexiSharp.Postgres.csproj" />

    <!-- Build tooling, referenced so its reader can be tested. Declared excluded from coverage:
         the console front end is not library code, and letting coverlet's default (which is every
         referenced assembly) pull it into the 60% line gate would make the gate depend on a CLI. -->
    <ProjectReference Include="../../bench/LexiSharp.CodeShape/LexiSharp.CodeShape.csproj" ExcludeFromCodeCoverage="true" />
    <ProjectReference Include="../../bench/LexiSharp.ApiDocs/LexiSharp.ApiDocs.csproj" ExcludeFromCodeCoverage="true" />
    <!-- The per-query analysis the BEIR harness reports with. Referenced so the slicing it produces
         is tested rather than trusted: a report that counts the wrong thing produces plausible
         numbers, and the mistake only surfaces in a conclusion drawn from it. Excluded from
         coverage, being bench code, whose coverage would flatter the library's own figure. -->
    <ProjectReference Include="../../bench/LexiSharp.Eval/LexiSharp.Eval.csproj" ExcludeFromCodeCoverage="true" />
    <!-- The demo, referenced so its option resolution and corpus reading are tested rather than
         trusted: both decide what a reader is shown and what gets indexed, and a wrong answer in
         either produces a page that looks right. Excluded from coverage, being sample code, whose
         coverage would flatter the library's own figure. -->
    <ProjectReference Include="../../samples/LexiSharp.Demo/LexiSharp.Demo.csproj" ExcludeFromCodeCoverage="true" />
  </ItemGroup>

</Project>